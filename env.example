# Supabase — Project Settings > API. The service role key bypasses RLS and must stay
# server-side; it is only ever read by the functions in api/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the session cookie. Use a long random string; rotating it logs everyone out.
JWT_SECRET=generate-a-long-random-string

# Used for links in outgoing email.
CLIENT_ORIGIN=http://localhost:3000

# Email (optional). Without it, inquiries are still recorded but the agent is not
# notified — the row lands with email_status 'failed'.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-api-key
# SMTP_FROM=noreply@topchoicerealty.com

{
  "name": "top-choice-realty",
  "version": "1.0.0",
  "private": true,
  "description": "Real estate web application for Top Choice Realty",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter web typecheck",
    "seed": "tsx scripts/seed.ts",
    "create-user": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "bcryptjs": "^3.0.2",
    "cookie": "^0.6.0",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.11.16",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vercel/node": "^3.2.29",
    "dotenv": "^16.4.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
